APP_NAME="Prospectra"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5433
DB_DATABASE=crm_internal
DB_USERNAME=crm_local
DB_PASSWORD=crm_pass

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_PREFIX=crm_internal_local_

# Queue reliability. Keep this order:
# job timeout (SyncGmailMessagesJob = 120s) < Horizon supervisor timeout < retry_after.
# Restart Horizon after changing these values.
HORIZON_SUPERVISOR_TIMEOUT=130
REDIS_QUEUE_RETRY_AFTER=150
# Required only when QUEUE_CONNECTION=database or beanstalkd:
# DB_QUEUE_RETRY_AFTER=150
# BEANSTALKD_QUEUE_RETRY_AFTER=150

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Proposal outbound email. Brevo SMTP is selected automatically when
# BREVO_SMTP_USERNAME is present. Set PROPOSAL_EMAIL_TRANSPORT=gmail to fall
# back to the Gmail API. Gmail still handles inbox reads and reply sync.
PROPOSAL_EMAIL_TRANSPORT=
PROPOSAL_FROM_EMAIL=hello@enigmative.web.id
PROPOSAL_FROM_NAME="Enigma Collective Studio"
PROPOSAL_REPLY_TO=hello@enigmative.web.id

BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_USERNAME=
BREVO_SMTP_PASSWORD=
# BREVO_SMTP_SCHEME=
# BREVO_SMTP_TIMEOUT=30

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Footer banner for Gmail drafts (absolute path). Defaults to public/images/email-footer-banner.jpg.
# EMAIL_BANNER_PATH=

# Gmail inbox synchronization (disabled by default)
GMAIL_PRIMARY_EMAIL=enigmativebusiness@gmail.com
GMAIL_SYNC_ENABLED=false
GMAIL_SYNC_INTERVAL_MINUTES=15
# Running markers older than the stale window are reclaimed by the next
# dispatch. Keep the lock TTL greater than the stale window.
GMAIL_SYNC_LOCK_TTL_MINUTES=60
GMAIL_SYNC_STALE_AFTER_MINUTES=30
GMAIL_SYNC_FAILURE_TTL_DAYS=7
# Optional cache store for all Gmail sync state: running markers, state
# transition locks, ShouldBeUnique locks, and WithoutOverlapping locks.
# Leave unset to use CACHE_STORE. The store must be shared by the web app and
# Horizon workers and must support atomic locks (redis, database, file, or array).
# GMAIL_SYNC_CACHE_STORE=redis
